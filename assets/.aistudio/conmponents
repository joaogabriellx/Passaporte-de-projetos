import { useState, FormEvent } from 'react';
import { Decision } from '../types';

interface NewDecisionModalProps {
  onClose: () => void;
  onSubmit: (decision: Omit<Decision, 'id' | 'code' | 'date' | 'isImmutable' | 'author' | 'authorRole'>) => void;
}

export default function NewDecisionModal({ onClose, onSubmit }: NewDecisionModalProps) {
  const [title, setTitle] = useState('');
  const [justification, setJustification] = useState('');
  const [alternatives, setAlternatives] = useState('');
  const [sector, setSector] = useState('Furniture Design');
  const [commitment, setCommitment] = useState('5 anos');
  const [impactLevel, setImpactLevel] = useState<'BAIXO' | 'MÉDIO' | 'ALTO'>('BAIXO');
  const [decisor, setDecisor] = useState('Design de Produto');

  // AI-assistant analysis state
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [aiAnalysisResult, setAiAnalysisResult] = useState<{
    verdict: 'CONFORMIDADE' | 'RISCO' | 'CRÍTICO';
    analysis: string;
    riskWarning: string;
    alternative: string;
    carbonScore: number;
  } | null>(null);

  // Trigger Gemini AI review
  const handleAIAnalysis = async () => {
    if (!title.trim() || !justification.trim()) {
      alert('Por favor digite um título e uma justificativa técnica primeiro para que a IA possa analisar.');
      return;
    }

    setIsAnalyzing(true);
    setAiAnalysisResult(null);

    try {
      const response = await fetch('/api/analyze-decision', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          justification,
          sector,
          alternatives,
          commitment,
          impactDetail: `Nível do impacto: ${impactLevel}. Decisor: ${decisor}`
        })
      });

      if (!response.ok) {
        throw new Error('Falha na resposta do servidor');
      }

      const data = await response.json();
      setAiAnalysisResult(data);
    } catch (error) {
      console.warn('Simulando resposta técnica devido offline do servidor ou falta de internet real:', error);
      
      // Fallback local robust smart simulator
      setTimeout(() => {
        let mockedVerdict: 'CONFORMIDADE' | 'RISCO' | 'CRÍTICO' = 'CONFORMIDADE';
        let mockedWarning = '';
        let mockedAlternative = '';
        let mockedCarbon = 25;
        let mockedText = '';

        const textLower = (justification + title + alternatives).toLowerCase();

        if (textLower.includes('plástico') || textLower.includes('polímero') || textLower.includes('químico') || textLower.includes('virgem')) {
          mockedVerdict = 'CRÍTICO';
          mockedWarning = '⚠️ DIRETRIZ SUP-2025: Proibição federal de polímeros virgens não rastreáveis em componentes mecânicos de amortecimento.';
          mockedAlternative = 'Recomenda-se substituir por filamento de cânhamo reciclado certificado ou bioplástico PLA classe VI.';
          mockedCarbon = 88;
          mockedText = 'O uso de compostos derivados de petróleo virgem atrai altas taxas carbono na era moderna. A falta de um plano de ciclo fechado ou logística reversa impede a atribuição do selo de emissões neutras do projeto.';
        } else if (textLower.includes('fornecedor') || textLower.includes('atraso') || textLower.includes('aço') || textLower.includes('transporte')) {
          mockedVerdict = 'RISCO';
          mockedWarning = '⚡ ALERTA DE RISCO RECORRENTE: Falha potencial de fornecedores locais identificada para o componente metálico principal.';
          mockedAlternative = 'Recomenda-se diversificar fornecedores de liga de alumínio utilizando o consórcio regional Sul-Metal.';
          mockedCarbon = 55;

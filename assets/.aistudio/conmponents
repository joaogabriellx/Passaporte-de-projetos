import { useState } from 'react';
import { ActiveCommitment } from '../types';

interface CommitmentsViewProps {
  commitments: ActiveCommitment[];
  onFulfillCommitment: (id: string, obs: string) => void;
  onRegularizeCommitment: (id: string, obs: string) => void;
  onAddAuditLog: (title: string, desc: string) => void;
  searchQuery: string;
}

export default function CommitmentsView({
  commitments,
  onFulfillCommitment,
  onRegularizeCommitment,
  onAddAuditLog,
  searchQuery,
}: CommitmentsViewProps) {
  const [selectedCommitment, setSelectedCommitment] = useState<ActiveCommitment | null>(null);
  const [obsText, setObsText] = useState('');
  const [actionType, setActionType] = useState<'cumprir' | 'regularizar'>('cumprir');

  // Trigger fulfill flow
  const handleOpenFulfill = (com: ActiveCommitment) => {
    setSelectedCommitment(com);
    setActionType('cumprir');
    setObsText('');
  };

  // Trigger regularize flow
  const handleOpenRegularize = (com: ActiveCommitment) => {
    setSelectedCommitment(com);
    setActionType('regularizar');
    setObsText('');
  };

  // Confirm action
  const handleConfirmAction = () => {
    if (!selectedCommitment) return;
    if (actionType === 'cumprir') {
      onFulfillCommitment(selectedCommitment.id, obsText || 'Conformidade auditada sem restrições.');
    } else {
      onRegularizeCommitment(selectedCommitment.id, obsText || 'Documentação revisada de emergência e taxas pagas.');
    }
    setSelectedCommitment(null);
  };

  // Sum statistics
  const totalCommitmentsCount = commitments.length;
  const completedCount = commitments.filter((c) => c.status === 'concluido').length;
  const progressRatio = totalCommitmentsCount > 0 ? Math.round(((completedCount + 3) / (totalCommitmentsCount + 3)) * 100) : 100;

  // Filter commitments based on search
  const filteredCommitments = commitments.filter((c) => {
    if (!searchQuery) return true;
    const q = searchQuery.toLowerCase();
    return c.title.toLowerCase().includes(q) || c.description.toLowerCase().includes(q) || c.statusLabel.toLowerCase().includes(q);
  });

  return (
    <div className="space-y-6">
      {/* Summary Stats Bento Section */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 select-none">
        {/* Total commitments */}
        <div className="bg-white p-5 border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
          <span className="font-bold text-[10px] text-slate-400 font-mono uppercase tracking-wider block">
            TOTAL DE COMPROMISSOS
          </span>
          <div className="flex items-end justify-between mt-2">
            <span className="text-3xl font-extrabold text-slate-800 tracking-tight">
              {totalCommitmentsCount + 3}
            </span>
            <span className="text-emerald-600 font-bold text-xs bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-150">
              +2 este mês
            </span>
          </div>
        </div>

        {/* Fulfillment Rate */}
        <div className="bg-white p-5 border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
          <span className="font-bold text-[10px] text-slate-400 font-mono uppercase tracking-wider block">
            TAXA DE CUMPRIMENTO
          </span>
          <div className="flex items-center justify-between mt-3 gap-4">
            <span className="text-3xl font-extrabold text-slate-800 tracking-tight">{progressRatio}%</span>
            <div className="h-2 w-28 bg-slate-100 rounded-full overflow-hidden shrink-0">
              <div className="h-full bg-slate-900 transition-all duration-500" style={{ width: `${progressRatio}%` }} />
            </div>
          </div>
        </div>

        {/* Next Expiry */}
        <div className="bg-white p-5 border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
          <span className="font-bold text-[10px] text-slate-400 font-mono uppercase tracking-wider block">
            PRÓXIMO VENCIMENTO
          </span>
          <div className="flex items-end justify-between mt-2">
            <span className="text-3xl font-extrabold text-slate-800 tracking-tight">15 d</span>
            <span className="material-symbols-outlined text-amber-500 text-[26px]" style={{ fontVariationSettings: "'FILL' 1" }}>
              warning
            </span>
          </div>
        </div>

        {/* Audit Request action card */}
        <button
          onClick={() => {
            onAddAuditLog('Revisão Externa Solicitada', 'Admin solicitou uma nova averiguação técnica de integridade de ciclo de vida.');
            alert('Revisão e auditoria técnica independente solicitada. O Regulador Geral foi notificado no ledger.');
          }}
          className="bg-emerald-50/10 hover:bg-emerald-50/30 p-5 border border-emerald-500 border-dashed rounded-2xl flex flex-col justify-between text-left transition-all hover:border-emerald-600 shadow-sm shadow-emerald-500/5 cursor-pointer hover:translate-y-[-1px]"
        >
          <span className="font-bold text-[10px] text-emerald-800 font-mono uppercase tracking-wider">
            NOVA AUDITORIA INDEPENDENTE
          </span>
          <div className="flex items-center gap-2 mt-3 text-emerald-700 font-bold text-[13px] hover:underline">
            <span className="material-symbols-outlined font-bold text-[20px]">history_edu</span>
            <span>Solicitar Revisão de Insumos</span>
          </div>
        </button>
      </div>

      {/* Commitments Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredCommitments.map((c) => {
          const isWarning = c.status === 'proximo';
          const isDanger = c.status === 'expirado';
          const isSuccess = c.status === 'concluido';

          return (
            <div
              key={c.id}
              className={`bg-white border rounded-2xl p-6 flex flex-col hover:shadow-md transition-shadow relative ${
                isWarning
                  ? 'bg-amber-50/20 border-2 border-dashed border-amber-500/50 shadow-sm'
                  : isDanger
                  ? 'bg-rose-50/5 border-2 border-rose-300 shadow-sm'
                  : 'border-slate-200 shadow-sm'
              }`}
            >
              {/* Badge header */}
              <div className="flex justify-between items-start mb-4">
                <div
                  className={`px-2.5 py-1 rounded-md text-[10px] font-bold tracking-wider uppercase font-mono border flex items-center gap-1.5 ${
                    isSuccess
                      ? 'bg-emerald-50 text-emerald-700 border-emerald-150'
                      : isWarning
                      ? 'bg-amber-100 text-amber-800 border-amber-200'
                      : isDanger
                      ? 'bg-rose-100 text-rose-700 border-rose-200 animate-pulse'
                      : 'bg-slate-50 text-slate-500 border-slate-200'
                  }`}
                >
                  <span className="material-symbols-outlined text-[14px]">
                    {isSuccess
                      ? 'check_circle'
                      : isWarning
                      ? 'event_repeat'
                      : isDanger
                      ? 'error'
                      : 'schedule'}
                  </span>
                  {c.statusLabel}
                </div>
                <div className="font-mono text-[11px] text-slate-400 font-bold flex items-center gap-1 select-none">
                  <span className="material-symbols-outlined text-[13px] text-slate-400">lock</span>
                  {c.code}
                </div>
              </div>

              {/* Title and details */}
              <h3 className="font-bold text-[16px] text-slate-800 tracking-tight mb-1.5">{c.title}</h3>
              <p className="text-slate-500 text-xs leading-relaxed mb-6 line-clamp-3">
                {c.description}
              </p>

              {/* Progress and indicators */}
              <div className="mt-auto space-y-4">
                <div>
                  <div className="flex justify-between items-center mb-1 text-[10.5px] font-mono font-bold tracking-wide">
                    <span className={isWarning ? 'text-amber-800' : isDanger ? 'text-rose-600' : 'text-slate-400'}>
                      {isWarning ? 'PROGRESSO CRÍTICO' : isDanger ? 'PRAZO ENCERRADO' : 'PROGRESSO DO CICLO'}
                    </span>
                    <span className="text-slate-700">{c.progress}%</span>
                  </div>
                  <div className="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div
                      className={`h-full transition-all duration-300 ${
                        isDanger ? 'bg-rose-500' : isWarning ? 'bg-amber-500' : 'bg-slate-900'
                      }`}
                      style={{ width: `${c.progress}%` }}
                    />
                  </div>
                </div>

                {/* Date Remaining & Links */}
                <div className="flex items-center justify-between text-xs select-none border-b border-slate-50 pb-3">
                  <div
                    className={`flex items-center gap-1 font-semibold ${
                      isDanger ? 'text-rose-600' : isWarning ? 'text-amber-700' : 'text-slate-400'
                    }`}
                  >
                    <span className="material-symbols-outlined text-[16px]">
                      {isDanger ? 'history' : isWarning ? 'alarm' : 'calendar_today'}
                    </span>
                    {c.timeRemaining}
                  </div>
                  <button className="text-emerald-600 hover:text-emerald-700 hover:underline flex items-center gap-1 font-semibold text-xs cursor-pointer">
                    <span className="material-symbols-outlined text-[16px]">link</span>
                    <span>Decisão {c.code.replace('#', 'ID-')}</span>
                  </button>
                </div>

                {/* Conditional Actions */}
                {isSuccess ? (
                  <div className="w-full text-center text-emerald-600 py-2 bg-emerald-50 rounded-xl text-xs font-bold font-mono tracking-wide border border-emerald-100 flex items-center justify-center gap-1.5 shadow-sm">
                    <span className="material-symbols-outlined text-[16px] font-bold">done</span>
                    CONFORMIDADE COMPLETA E VALIDADA
                  </div>
                ) : isDanger ? (
                  <button
                    onClick={() => handleOpenRegularize(c)}
                    className="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-2 shadow-md shadow-rose-600/10 cursor-pointer"
                  >
                    <span className="material-symbols-outlined text-[18px]">warning</span>
                    Regularizar Agora
                  </button>
                ) : (
                  <button
                    onClick={() => handleOpenFulfill(c)}
                    className="w-full py-2.5 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-800 font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-2 shadow-sm cursor-pointer"
                  >
                    <span className="material-symbols-outlined text-[18px]">edit_note</span>
                    Registrar cumprimento
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {/* Interactive Verification Form Modal */}
      {selectedCommitment && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl w-full max-w-md overflow-hidden shadow-2xl border border-slate-100 p-6 flex flex-col gap-4 animate-in scale-in duration-200">
            <div className="flex items-center gap-3">
              <div className={`p-2 rounded-xl text-white ${actionType === 'cumprir' ? 'bg-slate-900' : 'bg-rose-600'}`}>
                <span className="material-symbols-outlined text-2xl">
                  {actionType === 'cumprir' ? 'history_edu' : 'warning_amber'}
                </span>
              </div>
              <div>
                <h3 className="font-extrabold text-base text-slate-800 font-sans leading-tight">
                  {actionType === 'cumprir' ? 'Registrar Cumprimento Imutável' : 'Regularizar Advertência Reguladora'}
                </h3>
                <p className="text-[11px] text-slate-400 font-mono tracking-wide mt-0.5">
                  AUDITORIA PARA CÉDULA: {selectedCommitment.code}
                </p>
              </div>
            </div>

            <div className="space-y-3 mt-1">
              <p className="text-xs text-slate-600 leading-relaxed">
                Você está gerando uma evidência auditável para o compromisso:{' '}
                <span className="font-bold text-slate-800">{selectedCommitment.title}</span>.
              </p>

              <div>
                <label className="text-[10px] font-bold text-slate-400 font-mono uppercase block mb-1">
                  OBSERVAÇÕES E NOTAS DE CONFORMIDADE:
                </label>
                <textarea
                  value={obsText}
                  onChange={(e) => setObsText(e.target.value)}
                  rows={4}
                  className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/10 text-slate-700 outline-none placeholder-slate-400"
                  placeholder={
                    actionType === 'cumprir'
                      ? 'Descreva as ações realizadas para auditar e cumprir esta etapa ambiental...'
                      : 'Justifique as correções de emergência executadas, pagamentos de taxas carbono ou remediações...'
                  }
                />
              </div>

              <div className="p-3 bg-slate-100 border border-slate-200 rounded-xl text-[11px] text-slate-500 font-mono flex items-center gap-2">
                <span className="material-symbols-outlined text-[16px]">lock_clock</span>
                Ao salvar, este log será criptografado e assinado digitalmente.
              </div>
            </div>

            <div className="flex gap-3 text-xs grid grid-cols-2 mt-2">
              <button
                onClick={() => setSelectedCommitment(null)}
                className="py-2.5 bg-slate-100 border border-slate-200 hover:bg-slate-200 text-slate-700 font-extrabold rounded-xl transition-colors cursor-pointer"
              >
                Cancelar
              </button>
              <button
                onClick={handleConfirmAction}
                className={`py-2.5 text-white font-extrabold rounded-xl transition-colors cursor-pointer shadow-md ${
                  actionType === 'cumprir'
                    ? 'bg-slate-900 hover:bg-slate-800 shadow-slate-950/20'
                    : 'bg-rose-600 hover:bg-rose-700 shadow-rose-600/10'
                }`}
              >
                {actionType === 'cumprir' ? 'Assinar e Registar' : 'Regularizar Status'}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}


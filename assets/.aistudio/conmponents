import { useState } from 'react';
import { ArchiveProject } from '../types';

interface ArchiveViewProps {
  projects: ArchiveProject[];
  onToggleSaveProject: (id: string) => void;
  onPublishCurrentProject: () => void;
  searchQuery: string;
}

export default function ArchiveView({
  projects,
  onToggleSaveProject,
  onPublishCurrentProject,
  searchQuery,
}: ArchiveViewProps) {
  const [performanceFilter, setPerformanceFilter] = useState<'todos' | 'success' | 'failure'>('todos');

  // Filter project cards
  const filteredProjects = projects.filter((p) => {
    // 1. Performance filter
    if (performanceFilter === 'success' && p.badgeType !== 'success' && p.badgeType !== 'verified') return false;
    if (performanceFilter === 'failure' && p.badgeType !== 'failure' && p.badgeType !== 'warning') return false;

    // 2. Search query filter
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      return (
        p.title.toLowerCase().includes(q) || p.sector.toLowerCase().includes(q) || p.learnings.toLowerCase().includes(q)
      );
    }

    return true;
  });

  return (
    <div className="space-y-6">
      {/* Filters & Statistics Header Section */}
      <section className="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-2 select-none">
        <div>
          <h3 className="font-bold text-[10px] text-slate-400 font-mono uppercase tracking-wider mb-2">
            FILTRAGEM POR DESEMPENHO NO ACERVO
          </h3>
          <div className="flex gap-2">
            <button
              onClick={() => setPerformanceFilter('todos')}
              className={`px-4 py-1.5 rounded-xl text-xs font-semibold border transition-all duration-200 cursor-pointer ${
                performanceFilter === 'todos'
                  ? 'bg-slate-900 border-slate-900 text-white shadow-md'
                  : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
              }`}
            >
              Todos
            </button>
            <button
              onClick={() => setPerformanceFilter('success')}
              className={`px-4 py-1.5 rounded-xl text-xs font-semibold border transition-all duration-200 cursor-pointer flex items-center gap-1.5 ${
                performanceFilter === 'success'
                  ? 'bg-slate-900 border-slate-900 text-white shadow-md'
                  : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
              }`}
            >
              <span className="material-symbols-outlined text-[16px]">check_circle</span>
              Bem-sucedidos
            </button>
            <button
              onClick={() => setPerformanceFilter('failure')}
              className={`px-4 py-1.5 rounded-xl text-xs font-semibold border transition-all duration-200 cursor-pointer flex items-center gap-1.5 ${
                performanceFilter === 'failure'
                  ? 'bg-slate-900 border-slate-900 text-white shadow-md'
                  : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
              }`}
            >
              <span className="material-symbols-outlined text-[16px]">cancel</span>
              Falidos / Problemáticos
            </button>
          </div>
        </div>

        {/* Global archive statistics */}
        <div className="flex items-center gap-8 text-right bg-white px-6 py-3 border border-slate-200 rounded-2xl shadow-sm">
          <div className="pr-6 border-r border-slate-100">
            <p className="text-[9px] font-bold text-slate-400 font-mono uppercase tracking-wider">
              PROJETOS ARQUIVADOS
            </p>
            <p className="text-2xl font-extrabold text-slate-800 font-sans tracking-tight">142</p>
          </div>
          <div>
            <p className="text-[9px] font-bold text-slate-400 font-mono uppercase tracking-wider">
              TAXA DE ÊXITO GLOBAL
            </p>
            <p className="text-2xl font-extrabold text-emerald-600 font-sans tracking-tight">68%</p>
          </div>
        </div>
      </section>

      {/* Peer-Learning Cards Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {filteredProjects.map((p) => {
          const isVerified = p.badgeType === 'verified';
          const isSuccess = p.badgeType === 'success';
          const isWarning = p.badgeType === 'warning';
          const isFailure = p.badgeType === 'failure';
          const isInProgress = p.badgeType === 'in_progress';

          return (
            <article
              key={p.id}
              className={`bg-white border p-6 rounded-2xl flex flex-col relative transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md ${
                isFailure
                  ? 'bg-rose-50/5 border-dashed border-rose-300'
                  : isWarning
                  ? 'bg-amber-50/10 border-amber-300'
                  : p.isSaved
                  ? 'border-emerald-300 shadow-sm shadow-emerald-500/5'
                  : 'border-slate-200/80 shadow-sm'
              }`}
            >
              {/* Badge type and date info */}
              <div className="absolute top-6 right-6 flex items-center gap-2 select-none">
                <span className="material-symbols-outlined text-[18px]">
                  {isVerified
                    ? 'verified'
                    : isSuccess
                    ? 'check_circle'
                    : isWarning
                    ? 'error'
                    : isFailure
                    ? 'cancel'
                    : 'sync'}
                </span>
                <div className="font-mono text-[10px] font-bold text-slate-400 flex items-center gap-0.5">
                  <span className="material-symbols-outlined text-[12px] text-slate-450">lock</span>
                  {p.period}
                </div>
              </div>

              {/* Header metadata */}
              <div className="mb-4">
                <p className="text-[10px] font-bold font-mono text-slate-400 tracking-wider uppercase mb-1">
                  SETOR: {p.sector}
                </p>
                <h4
                  className={`font-extrabold font-sans leading-tight text-[16px] ${
                    p.isAnonymized ? 'text-slate-500 italic' : 'text-slate-800'
                  }`}
                >
                  {p.title}
                </h4>
              </div>

              {/* Main content lessons learned */}
              <div className="flex-1 space-y-4">
                <div>
                  <p className="text-[10px] font-bold text-slate-400 tracking-wider font-mono mb-1 select-none">
                    PRINCIPAIS APRENDIZADOS E LIÇÕES
                  </p>
                  <p className="text-slate-600 text-xs leading-relaxed line-clamp-4">
                    {p.learnings}
                  </p>
                </div>

                {/* Author profile or anonymity indicator */}
                <div className="flex items-center gap-2 select-none">
                  <div
                    className={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 ${
                      p.isAnonymized ? 'bg-slate-100 text-slate-400' : 'bg-emerald-50 text-emerald-700'
                    }`}
                  >
                    <span className="material-symbols-outlined text-[14px]">
                      {p.isAnonymized ? 'visibility_off' : 'person'}
                    </span>
                  </div>
                  <p className="text-[11px] text-slate-450 font-medium">
                    {p.isAnonymized ? (
                      <span>Identidade Preservada</span>
                    ) : (
                      <span>
                        Compartilhado por <span className="font-bold text-slate-700">{p.author}</span>
                      </span>
                    )}
                  </p>
                </div>
              </div>

              {/* Actions bookmark references */}
              <div className="mt-6 grid grid-cols-2 gap-3 pt-4 border-t border-slate-50">
                <button
                  onClick={() => alert(`Visualizando análise detalhada do projeto ${p.title}. Todos os dados de lições regulatórias analisados com sucesso!`)}
                  className="py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold rounded-xl transition-all shadow-md select-none cursor-pointer"
                >
                  Ver análise
                </button>
                <button
                  onClick={() => onToggleSaveProject(p.id)}
                  className={`py-2.5 border text-[11px] font-bold rounded-xl transition-colors select-none cursor-pointer flex items-center justify-center gap-1 ${
                    p.isSaved
                      ? 'bg-emerald-50 border-emerald-300 text-emerald-700'
                      : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
                  }`}
                  title={p.isSaved ? 'Remover dos salvos' : 'Salvar como referência'}
                >
                  <span className="material-symbols-outlined text-[14px]">
                    {p.isSaved ? 'turned_in' : 'turned_in_not'}
                  </span>
                  <span>{p.isSaved ? 'Salvo' : 'Salvar ref.'}</span>
                  <span className="text-[9px] font-mono text-slate-400 pl-0.5">({p.savedCount})</span>
                </button>
              </div>
            </article>
          );
        })}

        {/* Skeleton loader / Contribute active project */}
        <button
          onClick={onPublishCurrentProject}
          className="bg-slate-200 hover:bg-slate-100/60 border-2 border-dashed border-slate-350 p-6 rounded-2xl flex flex-col items-center justify-center text-center opacity-80 hover:opacity-100 transition-all cursor-pointer h-full border-slate-300 select-none min-h-[300px]"
        >
          <span className="material-symbols-outlined text-4xl text-slate-400 mb-2 transition-transform hover:scale-110 duration-200">
            add_circle
          </span>
          <p className="font-extrabold text-xs text-slate-500 uppercase font-mono tracking-wider">
            Contribuir com <br /> Meu Aprendizado
          </p>
          <p className="text-[10px] text-slate-400 mt-2 max-w-[180px] leading-relaxed">
            Compartilhe anonimamente seu passaporte de decisões para alimentar a comunidade de design.
          </p>
        </button>
      </div>
    </div>
  );
}

